APP_ENV=development

# PostgreSQL
POSTGRES_USER=trustops
POSTGRES_PASSWORD=trustops
POSTGRES_DB=trustops
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://trustops:trustops@postgres:5432/trustops

# Redis
REDIS_URL=redis://redis:6379/0

# Evidence Store (local filesystem for MVP)
EVIDENCE_STORE_PATH=/app/evidence/store

# JWT signing secret for user login (RBAC) — the default only works for local
# dev; any real deployment MUST override this with a long random value, or
# anyone can forge an admin token.
JWT_SECRET_KEY=dev-insecure-change-me
